# Base modular Noah-MP interface. WRF_HYDRO is intentionally disabled.
# Scheme and host metadata must use identical standard names and units.
########################################################################
[ccpp-arg-table]
  name = noahmp_init
  type = scheme
[horizontal_dimension]
  standard_name = horizontal_dimension
  long_name = horizontal dimension
  units = count
  dimensions = ()
  type = integer
  intent = in
[vertical_dimension_of_soil]
  standard_name = vertical_dimension_of_soil
  long_name = vertical dimension of soil
  units = count
  dimensions = ()
  type = integer
  intent = in
[vertical_dimension_of_surface_snow]
